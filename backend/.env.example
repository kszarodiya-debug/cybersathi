APP_NAME=CYBERSATHI API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://cybersathi_app:replace-with-a-local-secret@localhost:5432/cybersathi
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Keep false for web-service startup; run `alembic upgrade head` as a release step.
RUN_MIGRATIONS_ON_STARTUP=false
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=cybersathi-api
JWT_AUDIENCE=cybersathi-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
CHAT_RATE_LIMIT=20
ANALYSIS_RATE_LIMIT=30
SUBMISSION_RATE_LIMIT=60
AI_PROVIDER=openai_compatible
AI_API_KEY=replace-with-provider-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_HISTORY_MESSAGES=10
# CORS_ORIGINS is preferred; FRONTEND_ORIGINS remains supported for compatibility.
CORS_ORIGINS=http://localhost:5173

# Run the one-time admin bootstrap command with these values configured.
# Never commit the real password or place it in frontend configuration.
ADMIN_EMAIL=admin@example.edu
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-16-character-password
